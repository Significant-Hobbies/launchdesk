{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "launchdesk",
  "compatibility_date": "2026-09-18",
  "assets": {
    "directory": "./web"
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "launchdesk.significanthobbies.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
